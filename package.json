{
  "name": "drapeaux-en-tete",
  "version": "1.0.0",
  "private": true,
  "description": "Flashcards pour apprendre les drapeaux du monde : web app installable, hors ligne, répétition espacée FSRS-6.",
  "scripts": {
    "test": "node --test tests/data.test.js tests/fsrs.test.js",
